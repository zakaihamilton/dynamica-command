{
  "name": "dynamica-command",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "tsx scripts/inspect.ts",
    "sim": "tsx scripts/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "compress-art": "tsx scripts/compress-art.ts",
    "calibrate-portraits": "tsx scripts/calibrate-portraits.ts",
    "test:e2e": "tsx scripts/e2e-preflight.ts && playwright test",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd app components lib scripts",
    "health:coverage": "VITEST_COVERAGE=1 vitest run --coverage",
    "health:invariants": "vitest run tests/allSeeds.test.ts tests/terrain.test.ts tests/commander.test.ts",
    "health:performance": "tsx scripts/perf.ts",
    "health:balance": "tsx scripts/balance.ts --from 0 --to 39 --jobs 8 --check true --progress false",
    "ci:timed-tests": "vitest run --reporter=dot --reporter=json --outputFile=artifacts/test-timing.json",
    "ci:timed-performance": "tsx scripts/perf.ts > artifacts/performance-timing.json",
    "ci:timed-balance": "tsx scripts/balance.ts --from 0 --to 39 --jobs 8 --check true --progress false > artifacts/balance-timing.json",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#.repnix\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#generated\""
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "repnix": "^0.3.14",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
