{
  "name": "genesis-protocol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "tsx scripts/inspect.ts",
    "sim": "tsx scripts/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "compress-art": "tsx scripts/compress-art.ts",
    "test:e2e": "playwright test",
    "health": "repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd app components lib scripts",
    "health:coverage": "VITEST_COVERAGE=1 c8 --all --exclude='**/.next/**' --exclude='**/scripts/**' --exclude='**/tests/**' --exclude='**/*.config.*' --exclude='**/app/**' --exclude='**/components/**' --reporter=text yarn test",
    "health:performance": "tsx scripts/perf.ts",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#.repnix\" \"#node_modules\" \"#playwright-report\" \"#test-results\" \"#coverage\" \"#dist\" \"#build\" \"#.next\" \"#.turbo\" \"#.git\" \"#generated\""
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "license-checker": "^25.0.1",
    "markdownlint-cli2": "^0.23.2",
    "repnix": "^0.3.14",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
